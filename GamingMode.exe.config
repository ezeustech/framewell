<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- The app loads its bundled Windows-tool assemblies in full trust.
         This also permits those local dependencies to retain download marks.
         It does not remove Windows security/reputation checks or modify policy. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
